DB_URL=jdbc:postgresql://localhost:5432/nova_payment_service
DB_USERNAME=Username
DB_PASSWORD=yourPassword

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Generate independent random values of at least 32 characters.
MVOLA_CALLBACK_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Internal MockMobileProvider API (use the same key configured in MockMobileProvider)
MOBILE_PROVIDER_BASE_URL=http://localhost:4010
MOBILE_PROVIDER_API_KEY=replace-with-the-mock-provider-api-key

# Sender wallets must already exist and be active in MockMobileProvider
MVOLA_MERCHANT_MSISDN=0343500001
ORANGE_MONEY_MERCHANT_MSISDN=0321234567

# Required by the existing application configuration
SMS_WEBHOOK_URL=http://localhost:4010
SMS_API_KEY=replace-with-your-sms-api-key
OTP_SECRET=replace-with-a-random-secret
PAYOUT_ENCRYPTION_KEY=base64-encoded-32-byte-AES-key
